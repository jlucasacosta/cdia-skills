{
  "description": "Plugin CDIA · estado del proyecto al abrir una sesión (solo si hay fases del Método CDIA en SPEC.md o PLAN.md)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/estado.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
